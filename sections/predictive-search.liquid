{%- if predictive_search.performed -%}
  <div class="helix-predictive-search" role="listbox" aria-label="{{ 'sections.header.search_results' | t }}">
    {%- if predictive_search.resources.queries.size > 0 -%}
      <div class="helix-predictive-search__group">
        <h3>{{ 'sections.header.suggestions' | t }}</h3>
        <ul role="list">
          {%- for query in predictive_search.resources.queries -%}
            <li role="option"><a href="{{ query.url }}">{{ query.styled_text }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="helix-predictive-search__group">
        <h3>{{ 'sections.header.products' | t }}</h3>
        <ul role="list">
          {%- for product in predictive_search.resources.products -%}
            {%- assign predictive_image_alt = product.featured_image.alt | default: product.title -%}
            <li role="option">
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '58px', loading: 'lazy', alt: predictive_image_alt }}
                {%- endif -%}
                <span><strong>{{ product.title | escape }}</strong><br><small>{{ product.price | money }}</small></span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.collections.size > 0 -%}
      <div class="helix-predictive-search__group">
        <h3>{{ 'sections.header.collections' | t }}</h3>
        <ul role="list">
          {%- for collection in predictive_search.resources.collections -%}
            <li role="option"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.queries.size == 0 and predictive_search.resources.products.size == 0 and predictive_search.resources.collections.size == 0 -%}
      <p>{{ 'sections.header.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
