      <div class=" block-slide-lg lh-slick-big swiper-container">
        <div class="swiper-wrapper">
          {%- for media in product.media -%}
			{% assign pos = media.position | minus: 1%}

				{% case media.media_type %}
					{% when 'image' %}
						<div class="items-media swiper-slide zoom__image" data-variant_id="{{product.images[pos].variants | map:'id' | join: ',' }}">
							<img src="{{ media.preview_image | img_url: "master"}}" data-w="{{product.images[pos].width}}" data-h="{{product.images[pos].height}}" data-zoom-image="{{ media.preview_image | img_url: "master"}}" alt="{{ media.alt}}">
						</div>
					{% when 'external_video' %}
						<div class="items-media swiper-slide lh-external-video">
							<div class="product-single__media" style="padding-top: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
								{{ media | external_video_tag }}
							</div>
						 </div>
					{% when 'video' %}
						<div class="items-media swiper-slide lh-video">
							<div class="product-single__media product-single__media--video product-single__media--{{ media.id }}" style="padding-top: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
							{{ media | video_tag: class: 'media-video', image_size: image_size , controls: true }}
							</div>
						</div>
					{% when 'model' %}
						<div class="items-media swiper-slide no-answer-yet lh-model">
							<div class="product-single__media" style="padding-top: 100%">
								{{ media | model_viewer_tag: image_size: image_size, reveal: 'interaction', toggleable: true, data-model-id: media.id }}
								<div class="lh-view-space">
									<button class="product-single__view-in-space" data-shopify-xr data-shopify-model3d-id="{{ media.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>
										<span  data-lhi="trans_view_space" data-lh-lang>{{ 'LkK2y7Jpwd.lh_k428n8_space' | t }}</span>
									</button>
								</div>
							</div>
						</div>
					{% else %}
						<div class="items-media swiper-slide">
							<div class="product-single__media" style="padding-top: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
							{{ media | media_tag: class: 'media-item', image_size: image_size }}
							</div>
						</div>
				{% endcase %}
		{%- endfor -%}</div>
