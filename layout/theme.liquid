<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {{ content_for_header }}
    {%- liquid
      assign body_font_bold = settings.body_font | font_modify: 'weight', '700'
      assign body_font_medium = settings.body_font | font_modify: 'weight', '500'
    -%}
    {% style %}
      {{ settings.body_font | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      :root {
        --font-body-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        --color-background: {{ settings.color_background }};
        --color-foreground: {{ settings.color_foreground }};
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="theme-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
